// Version information for SprigCast Camera (see version.h): Windows shows it in the file's Properties, and
// SprigCast and Setup read FILEVERSION's first number to know whether the installed camera is older.
#include <winver.h>
#include "version.h"
#define SC_STR2(x) #x
#define SC_STR(x) SC_STR2(x)
#define SC_VERSION_TEXT SC_STR(SPRIGCAST_CAMERA_VERSION) ".0.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SPRIGCAST_CAMERA_VERSION,0,0,0
 PRODUCTVERSION SPRIGCAST_CAMERA_VERSION,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Slothbloom"
            VALUE "FileDescription", "SprigCast Camera"
            VALUE "FileVersion", SC_VERSION_TEXT
            VALUE "ProductVersion", SC_VERSION_TEXT
            VALUE "ProductName", "SprigCast"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
