      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/mute/key0",
          "Name": "On",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/mute/key1",
          "Name": "Muted",
          "TitleAlignment": "bottom"
        }
      ],
      "DisableAutomaticStates": true
    },
    {
      "Name": "Show or hide",
      "UUID": "com.sprigcast.sprigcast.item",
