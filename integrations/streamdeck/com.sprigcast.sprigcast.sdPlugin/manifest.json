{
  "Name": "SprigCast",
  "Version": "0.1.0.0",
  "Author": "SprigCast",
  "Actions": [
    {
      "Name": "Show bloom",
      "UUID": "com.sprigcast.sprigcast.bloom",
      "Icon": "imgs/actions/bloom/icon",
      "Tooltip": "Put a bloom on air. Lights up while it's on air.",
      "PropertyInspectorPath": "ui/settings.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/bloom/key0",
          "Name": "Off air",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/bloom/key1",
          "Name": "On air",
          "TitleAlignment": "bottom"
        }
      ],
      "DisableAutomaticStates": true
    },
    {
      "Name": "Mute sound",
      "UUID": "com.sprigcast.sprigcast.mute",
      "Icon": "imgs/actions/mute/icon",
